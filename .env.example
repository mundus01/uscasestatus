# Supabase — database + Auth (email/password, magic link, Google OAuth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email (track confirm + status alerts)
RESEND_API_KEY=
# Optional override; defaults to alerts@updates.uscasestatus.com
# RESEND_FROM_EMAIL=uscasestatus.com <alerts@updates.uscasestatus.com>

# Protects /api/cron/* in production (Vercel Cron sends Bearer $CRON_SECRET)
CRON_SECRET=

# Upstash Redis — caching and rate limiting.
# Optional in local development: without these, caching is skipped and rate
# limits allow every request.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Official USCIS Case Status API (Torch / OAuth client credentials).
# Register at https://developer.uscis.gov — sandbox first, then production demo.
# Sandbox base: https://api-int.uscis.gov
# Production base: https://api.uscis.gov
# When unset, the app uses deterministic mock fixtures so the UI still works.
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
USCIS_API_BASE=https://api-int.uscis.gov
# Force mock fixtures even if credentials are present:
# USCIS_USE_MOCK=true

# Canonical site origin — used for metadata, emails, and auth emailRedirectTo.
# Local: http://localhost:3000
# Production (Vercel): https://uscasestatus.com  (required — do NOT use localhost)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
